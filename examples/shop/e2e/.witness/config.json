{
  "version": 1,
  "language": "typescript",
  "baseURL": "http://localhost:4101",
  "testDir": "tests",
  "playwrightConfig": "playwright.config.ts",
  "verifyProject": "chromium",
  "roles": {
    "customer": {
      "storageState": "playwright/.auth/customer.json",
      "usernameEnv": "SHOP_CUSTOMER_EMAIL",
      "passwordEnv": "SHOP_CUSTOMER_PASSWORD"
    },
    "admin": {
      "storageState": "playwright/.auth/admin.json",
      "usernameEnv": "SHOP_ADMIN_EMAIL",
      "passwordEnv": "SHOP_ADMIN_PASSWORD"
    }
  },
  "authSetupCommand": "npx playwright test --project=setup",
  "browser": {
    "channel": null,
    "locale": "en-US",
    "timezoneId": "UTC",
    "viewport": [
      1280,
      800
    ]
  },
  "testIdAttribute": "data-testid",
  "credentialEnv": [],
  "verify": {
    "repeat": 3,
    "cpuThrottle": 4
  }
}